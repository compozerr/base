{
  "name": "base",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "install:dep": "(npm list -g ts-node || npm install -g ts-node) > /dev/null 2>&1 && ts-node scripts/install.ts",
    "dev": "deno run --allow-all scripts/dev.ts",
    "serve": "deno run --allow-all scripts/serve.ts",
    "deploy": "nbgv tag && git push origin --tags"
  },
  "devDependencies": {
    "prettier": "^3.7.3",
    "shadcn": "^3.5.1",
    "turbo": "^2.6.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.4",
  "workspaces": [
    "**/frontend"
  ]
}
