FROM node:22 AS builder
RUN npm install -g turbo

ARG APP_VERSION=dev

WORKDIR /app

# Cache-bust: changing this arg invalidates COPY and all subsequent layers
ARG CACHE_BUST=dev
COPY . .

# Install dependencies
RUN npm i

# Fetch the latest install.sh from remote storage before building
RUN curl -s "https://storage.googleapis.com/compozerr.firebasestorage.app/install.sh?cachebust=$(date +%s)" -o frontend/public/install.sh

# Build the frontend with version embedded
ENV VITE_APP_VERSION=$APP_VERSION
RUN turbo build

# Stage 2: Production stage
FROM node:22-alpine

WORKDIR /app

# Copy necessary files for serving
COPY --from=builder /app/frontend/dist ./frontend/dist

# Install serve globally for serving static content with SPA support
RUN npm install -g serve

WORKDIR /app

EXPOSE 5173

# Use serve with SPA mode (-s flag) to handle client-side routing
CMD ["serve", "-s", "frontend/dist", "-l", "5173"]
