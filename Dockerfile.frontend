FROM node:22 AS builder

ARG APP_VERSION=dev

WORKDIR /app
COPY . .

# Install dependencies
RUN npm ci

# Fetch the latest install.sh from remote storage before building
RUN curl -s "https://storage.googleapis.com/compozerr.firebasestorage.app/install.sh?cachebust=$(date +%s)" -o frontend/public/install.sh

# Build the frontend with version embedded
ENV VITE_APP_VERSION=$APP_VERSION
RUN npm run build -w frontend

# Stage 2: Production stage
FROM node:22-alpine

WORKDIR /app

# Copy necessary files for serving
COPY --from=builder /app/frontend/dist ./frontend/dist

# Install serve globally for serving static content with SPA support
RUN npm install -g serve

WORKDIR /app

EXPOSE 5173

# Use serve with SPA mode (-s flag) to handle client-side routing
# serve.json (copied from frontend/public/ by Vite) sets Cache-Control headers:
#   - index.html: no-cache (browser always checks for fresh version on deploy)
#   - assets/*:   immutable (Vite hashes filenames, safe to cache forever)
CMD ["serve", "-s", "frontend/dist", "-l", "5173", "-c", "frontend/dist/serve.json"]
