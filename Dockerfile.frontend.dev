FROM node:22

WORKDIR /app

# Copy everything first so workspace packages (e.g. @repo/stripe, @repo/auth)
# are available during npm ci
COPY . .

RUN npm ci

WORKDIR /app/frontend

EXPOSE 3001

# Run Vite dev server (port 3001 is set in package.json, add host flag for Docker)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
